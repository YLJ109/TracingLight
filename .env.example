# 溯光 TracingLight 环境变量配置

# ========== 智谱 AI ==========
# 在 https://open.bigmodel.cn 注册获取 API Key
ZHIPU_API_KEY=your_zhipu_api_key_here
# 模型选择: glm-4-flash (免费/推荐) | glm-4-plus (付费/更强)
ZHIPU_MODEL=glm-4-flash

# ========== JWT 认证 ==========
# 随机字符串，用于签发和验证 JWT Token
JWT_SECRET=change_this_to_a_random_secret_string

# ========== 数据库 ==========
# 驱动固定为 PostgreSQL
DATABASE_DRIVER=postgres
# 默认连接本机/本地 PostgreSQL（端口 5433）。两种启动方式：
#   1) 直接启动: 你有自己的本机 PostgreSQL，监听 localhost:5433
#      （执行 setup.bat / start.bat）
#   2) Docker 管理: 用 docker compose 起一个 pg 容器，映射到宿主机 5433
#      （执行 docker/setup-docker.bat / docker/start-docker.bat，均在 docker/ 目录）
# 若你的 PostgreSQL 在 5432，把链接的 5433 改成 5432 即可。
DATABASE_URL=postgres://tracinglight:tracinglight_pw@localhost:5433/tracinglight

# ========== 服务 ==========
NODE_ENV=production
PORT=5000
